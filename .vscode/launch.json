{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug DOOM ASCII (GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/doom_ascii.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb.exe",
      "setupCommands": [
        {
          "description": "Habilitar pretty-printing para gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Compilar DOOM ASCII"
    },
    {
      "name": "Debug Testes Unitarios (GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/test_runner.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb.exe",
      "preLaunchTask": "Rodar Testes"
    }
  ]
}
